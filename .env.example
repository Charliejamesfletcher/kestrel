# Copy to .env and fill in. Never commit .env.

# Postgres (docker compose uses these to create the database)
POSTGRES_USER=kestrel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kestrel

# Used by the API, worker and migrations
DATABASE_URL=postgres://kestrel:change-me@localhost:5432/kestrel

# API
PORT=3000
NODE_ENV=development

# Sent to Chess.com and Lichess with every request so they can contact you
CONTACT_EMAIL=you@example.com
APP_NAME=kestrel
APP_VERSION=0.1.0
