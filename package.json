{
  "name": "kestrel",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/db",
    "packages/api",
    "packages/worker",
    "packages/web",
    "packages/extension"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @kestrel/api",
    "dev:worker": "npm run dev -w @kestrel/worker",
    "dev:web": "npm run dev -w @kestrel/web",
    "migrate": "npm run migrate -w @kestrel/db",
    "scout": "npm run scout -w @kestrel/worker --",
    "remove": "npm run remove -w @kestrel/worker --",
    "fixture": "npm run fixture -w @kestrel/worker --",
    "backfill": "npm run backfill -w @kestrel/worker",
    "typecheck": "tsc -b && tsc -p packages/web",
    "test": "vitest run",
    "build": "tsc -b && npm run build -w @kestrel/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
